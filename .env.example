# Supabase Public API (Accessible by client & server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Used ONLY for server-side test seeding and migrations; NEVER exposed in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Dedicated Server-Only Secret for Password Recovery HMAC Signing (min 32 characters; NEVER expose to client)
RECOVERY_GRANT_SECRET=your-32-character-or-longer-recovery-grant-secret

# Application Base URL (Used for auth redirects and callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
